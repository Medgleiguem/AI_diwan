
# ── LLM Provider ──────────────────────────────────────────────────────────────
# Which LLM to use for poem generation and chat.
# Options: gemini (default, free) | claude (best Arabic quality) | groq (fast, free tier)
LLM_PROVIDER=gemini

# ── Gemini (Google) — FREE tier available ─────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# ── Claude (Anthropic) — Best Arabic quality ──────────────────────────────────
# Get key at: https://console.anthropic.com
# Set LLM_PROVIDER=claude to use
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Groq — Fast, free tier ────────────────────────────────────────────────────
# Get free key at: https://console.groq.com
# Set LLM_PROVIDER=groq to use
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Generation settings ────────────────────────────────────────────────────────
MAX_RETRIES=4

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
PORT=5000